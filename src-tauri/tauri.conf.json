{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Resolve Organizer",
  "version": "2.0.0",
  "identifier": "com.ccnfrank.resolveorganizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Resolve Organizer",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Bin structures for DaVinci Resolve",
    "longDescription": "Resolve Organizer builds the bin folder structure of a DaVinci Resolve project on disk, from a graph you shape or from a ready-made template.",
    "copyright": "Copyright © Christian Frank",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
